# Environment & API Keys & Credentials
.env
.env.*
!.env.example
*.env
.env.local
*.key
*.pem
cookies.json
credentials*.json
client_secrets*.json

# Chroma Vector Database (large files)
rag_knowledge_base/chroma_db/*
!rag_knowledge_base/chroma_db/.gitkeep

# Raw data files (large)
rag_knowledge_base/data/raw/*.pdf

# Chunks directory (generated)
rag_knowledge_base/data/chunks/*
!rag_knowledge_base/data/chunks/.gitkeep

# Node / Python
node_modules/
__pycache__/
*.pyc
.venv/
venv/

# Build artifacts
frontend/dist/
frontend/build/
frontend/.vite/
.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# RAG build artifacts (generated, don't track in git)
rag_knowledge_base/data/cleaned/
rag_knowledge_base/vector_db/
rag_knowledge_base/data/chunks/
